# Copy this file to .env and fill in your own values (.env is gitignored).

# Cloud "big brain" API keys.
# Primary: Groq free tier (https://console.groq.com)
GROQ_API_KEY=
# Fallbacks (enable in config.yaml brain.providers):
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Auto-accept Coqui XTTS license (CPML, personal/non-commercial use)
COQUI_TOS_AGREED=1

# LAN auth: non-localhost clients must send this token
# (open the PWA once with ?token=<value>). Generate any random hex string.
COMPANION_AUTH_TOKEN=

# Real WhatsApp numbers, one per profile id in config.yaml's `profiles:`
# (COMPANION_NUMBER_<ID>, uppercased). config.yaml is tracked in git - never
# put a real phone number there; set it here instead (.env is gitignored).
COMPANION_NUMBER_MAIN=
COMPANION_NUMBER_FRIEND=

# Telephony (N9) - a real, dialable phone number. Also set telephony.enabled:
# true in config.yaml. Needs a Twilio account (https://www.twilio.com), a
# purchased phone number, and its Voice webhook pointed at
# https://<your-public-url>/telephony/incoming-call (POST) - this app is
# LAN-only, so you also need a public HTTPS tunnel (e.g. ngrok, Cloudflare
# Tunnel) in front of it. See IMPLEMENTATION_LOG.md for the full checklist.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
